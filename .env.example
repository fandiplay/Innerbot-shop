# Copy this file to .env in the repository root. Never put real numbers here.
# ADMIN_NUMBERS: your admin number(s), separated by commas. Leave blank for no admin.
# Use international digits (country code + number), or Indonesian 08 format.
ADMIN_NUMBERS=

# Start the built-in shop with the bot: 1 = yes, 0 = no.
SHOP_ENABLED=1
SHOP_HOST=127.0.0.1
SHOP_PORT=3000

# Optional: your real HTTPS origin after configuring a tunnel/reverse proxy.
# Leave blank for local use. Setting this does not create a public URL.
SHOP_PUBLIC_URL=
SHOP_RATE_LIMIT=120
